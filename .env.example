# MongoDB — needed to run the app. The tests do not use any of this; they
# start a throwaway database of their own.
# Option A: a full connection string.
# For a local database (`npm run db:start`) use:
# MONGODB_URI=mongodb://127.0.0.1:27017
# For a hosted Atlas cluster use:
# MONGODB_URI=mongodb+srv://user:password@your-cluster.mongodb.net/?appName=Cluster0
# Option B: provide the parts (used when MONGODB_URI is not set)
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_CLUSTER_HOST=your-cluster.xxxxx.mongodb.net
# Database name (optional, defaults to nolidz).
# If an older deploy still uses ecommerce-nextjs, set that explicitly:
# MONGODB_DB=ecommerce-nextjs
# MONGODB_DB=nolidz

# NextAuth
NEXTAUTH_SECRET=
# Required in production (e.g. https://your-domain.com) for OAuth callbacks
NEXTAUTH_URL=http://localhost:3000
# Optional: leave both blank and the "Continue with Google" button is hidden,
# leaving email and password as the only way in. Set both, never one.
# Credentials come from a Google Cloud OAuth 2.0 client; its authorized
# redirect URI must be <NEXTAUTH_URL>/api/auth/callback/google.
GOOGLE_ID=
GOOGLE_SECRET=

# Comma-separated emails allowed to access /admin (product CRUD)
ADMIN_EMAILS=you@example.com

# Cloudinary (admin image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional upload folder
# CLOUDINARY_UPLOAD_FOLDER=nolidz/products

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Checkout offers card + PayPal. Enable PayPal in the Stripe Dashboard
# (Settings → Payment methods) for both test and live mode.

# Resend (order confirmation emails — optional in dev)
# Get an API key at https://resend.com
RESEND_API_KEY=
# For testing, Resend allows onboarding@resend.dev to your own verified inbox.
# For production, use a verified domain: nolidz <orders@yourdomain.com>
RESEND_FROM_EMAIL=nolidz <onboarding@resend.dev>

# App URL (no trailing slash — used for Stripe redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — only needed if the API runs on a different origin.
# Leave unset in normal Next.js deploys (cart uses same-origin /api/cart).
# NEXT_PUBLIC_API_URL=https://api.example.com

# DeepL (product description + colour name translation for German)
# Get a free key at https://www.deepl.com/pro-api — unset is fine: the shop
# keeps showing English catalog copy until a key is set.
DEEPL_AUTH_KEY=
# Optional; defaults to the Free endpoint. Pro accounts use https://api.deepl.com
# DEEPL_API_URL=https://api-free.deepl.com

# DHL (developer.dhl.com → My Apps → your app)
# NOTE: our production request (No. 202115) was REJECTED — DHL requires a
# business email on the company domain. Resubmit from one. Until then this
# stays empty and tracking reports itself as unconfigured. See SHIPPING.md.
# Shipment Tracking — Unified. Unset is fine: the admin "Check carrier status"
# button reports it as unconfigured and nothing else calls DHL. Covers both
# standard and express delivery — they are two service codes on one key.
DHL_API_KEY=
# Only needed for label creation (Parcel DE Shipping v2 OAuth2), which is not
# built yet and needs a DHL business contract. Server-side only.
# DHL_API_SECRET=

# DPD Germany tracking. Not needed yet: DPD is held back from checkout
# (offered: false in app/lib/shipping.ts) until the contract is signed.
#
# All three are required together — with any one missing the app treats DPD as
# unconfigured, which is a supported state: a parcel shipped DPD by hand still
# shows its tracking number, it just cannot be polled from the admin screen.
#
# Unlike DHL there is no self-service signup. These come from a DPD business
# contract (a Kundennummer and the myDPD/DPD Cloud API access granted against
# it); DPD issues the delisId and password, and confirms which host to use.
# DPD_API_URL=https://public-ws-stage.dpd.com/services
# DPD_DELIS_ID=
# DPD_PASSWORD=
